# 요청/응답 모델 (rag_fastapi.py에서 가져옴)
class 채팅_요청(RAGRequest):
    """채팅 요청을 위한 모델 (RAGRequest를 상속)"""
    pass

async def get_rag_response(query: str, top_k: int = 5, generated_answer: bool = True, media_type: str = None) -> Dict[str, Any]:
    """RAG 시스템에서 직접 응답 가져오기"""
    try:
        if search_integration is None:
            raise Exception("RAG 시스템이 초기화되지 않았습니다.")
            
        # print(f"[DEBUG] 쿼리 처리 중: {query}")
        # print(f"[DEBUG] top_k: {top_k}, generated_answer: {generated_answer}, media_type: {media_type}")
        
        # RAG 시스템을 사용하여 쿼리 처리 및 응답 생성
        search_output = await asyncio.to_thread(
            search_integration.process_query,
            query=query,
            top_k=top_k,
            media_type=media_type,
            generate_answer=generated_answer
        )
        
        # RAG 시스템에서 반환된 결과 처리
        retrieved_documents = search_output.get('retrieved_documents', search_output.get('results', []))
        answer = search_output.get('generated_answer') or search_output.get('answer')
        
        # RAG 시스템에서 생성된 답변이 없는 경우
        if not answer and generated_answer and generator:
            try:
                # RAG 시스템에서 답변을 생성하지 않은 경우에만 여기서 생성
                answer = await asyncio.to_thread(
                    generator.generate,
                    prompt=f"사용자 질문: {query}\n\n이 질문에 대해 아는 정보가 있다면 설명해주세요. 만약 정보가 없다면, 관련 정보를 찾을 수 없다고 답변해주세요. 답변은 한국어로만 해주세요.",
                    max_tokens=256
                )
            except Exception as e:
                print(f"대체 답변 생성 중 오류 발생: {str(e)}")
                answer = "답변을 생성하는 중에 오류가 발생했습니다."
        
        # 최종 결과 형식 맞추기
        result = {
            'success': True,
            'query': query,
            'results': retrieved_documents,
            'answer': answer or "질문에 대한 답변을 찾을 수 없습니다.",
            'generated_answer': bool(answer)
        }
        
        print(f"[DEBUG] Raw RAG response: {json.dumps(result, indent=2, ensure_ascii=False)[:500]}...")  # 로그 길이 제한
        
        # Format the response
        formatted_results = []
        images = []
        
        # RAG 시스템에서 반환된 답변 사용
        final_answer = result.get('answer')
        
        # 결과 항목 처리
        for item in result.get('results', []):
            # 미디어 타입 필터링
            item_media_type = item.get('media_type', 'text')
            if media_type and item_media_type != media_type:
                continue
                
            # 결과 항목 포맷팅
            result_item = {
                'score': float(item.get('score', 0.0)),
                'content': item.get('content', item.get('text', '')),
                'metadata': item.get('metadata', {}),
                'media_type': item_media_type,
                'file_path': item.get('file_path', ''),
                'caption': item.get('caption', '')
            }
            
            # 이미지 파일 경로가 있는 경우에만 추가
            image_path = item.get('file_path')
            if image_path and os.path.exists(image_path) and any(image_path.lower().endswith(ext) for ext in ['.jpg', '.jpeg', '.png', '.gif']):
                images.append({
                    'path': image_path,
                    'caption': item.get('caption', item.get('content', ''))
                })
            
            formatted_results.append(result_item)
        
        # RAG 시스템에서 생성된 답변이 없는 경우에만 첫 번째 결과를 답변으로 사용
        if not final_answer and formatted_results:
            first_result = formatted_results[0]
            final_answer = first_result.get('content', first_result.get('caption', first_result.get('text', '')))
        
        # process_response_with_images를 사용하여 응답 처리
        if final_answer:
            # 이미지가 포함된 응답 처리
            processed = process_response_with_images(final_answer)
            final_answer = processed['response']
            
            # process_response_with_images에서 추출한 이미지 경로 처리
            for img_data in processed.get('images', []):
                # 이미지 데이터가 딕셔너리인 경우
                if isinstance(img_data, dict):
                    # 이미지 경로가 있는 경우 base64로 인코딩
                    if 'path' in img_data and os.path.exists(img_data['path']):
                        try:
                            with open(img_data['path'], 'rb') as img_file:
                                base64_image = base64.b64encode(img_file.read()).decode('utf-8')
                                images.append({
                                    'base64': base64_image,
                                    'title': os.path.splitext(os.path.basename(img_data['path']))[0],
                                    'index': str(len(images) + 1),
                                    'page_num': '1'  # 기본값으로 1 설정
                                })
                        except Exception as e:
                            print(f"이미지 로드 중 오류 발생 ({img_data['path']}): {str(e)}")
                # 이미지 경로가 문자열인 경우
                elif isinstance(img_data, str) and os.path.exists(img_data):
                    try:
                        with open(img_data, 'rb') as img_file:
                            base64_image = base64.b64encode(img_file.read()).decode('utf-8')
                            images.append({
                                'base64': base64_image,
                                'title': os.path.splitext(os.path.basename(img_data))[0],
                                'index': str(len(images) + 1),
                                'page_num': '1'  # 기본값으로 1 설정
                            })
                    except Exception as e:
                        print(f"이미지 로드 중 오류 발생 ({img_data}): {str(e)}")
            
            # RAG 응답에서 직접 이미지 경로 추출 (process_response_with_images에서 찾지 못한 경우 대비)
            if not images and isinstance(search_output.get('images'), list):
                for img_info in search_output['images']:
                    if isinstance(img_info, dict) and 'path' in img_info and os.path.exists(img_info['path']):
                        try:
                            with open(img_info['path'], 'rb') as img_file:
                                base64_image = base64.b64encode(img_file.read()).decode('utf-8')
                                images.append({
                                    'base64': base64_image,
                                    'title': os.path.splitext(os.path.basename(img_info['path']))[0],
                                    'index': str(len(images) + 1),
                                    'page_num': '1'  # 기본값으로 1 설정
                                })
                        except Exception as e:
                            print(f"이미지 로드 중 오류 발생 ({img_info['path']}): {str(e)}")

        # 응답 구성
        response = {
            'success': True,
            'query': query,
            'answer': final_answer or "질문에 대한 답변을 찾을 수 없습니다.",
            'results': formatted_results,
            'images': images,
            'generated_answer': result.get('generated_answer', False)
        }
        
        # print(f"[DEBUG] Formatted response: {json.dumps(response, indent=2, ensure_ascii=False)[:500]}...")
        
        # 응답에서 이미지 경로만 제거
        if 'answer' in response:
            # 이미지 관련 텍스트 패턴들 제거 ("관련 이미지"는 유지)
            patterns = [
                # 1. "Relevant Images: path : /path/to/image" 형식
                r'(?i)Rel?le?v?ant Images:.*?[\r\n]+path : .*?[\r\n]+',
                # 2. "Relevant Images: /path/to/image (description)" 형식
                r'(?i)Rel?le?v?ant Images:.*?\([^)]*\)[\r\n]+',
                # 3. "Relevant Images: /path1, /path2, ..." 형식
                r'(?i)Rel?le?v?ant Images:.*?(?:[\r\n]+|$)',
                # 4. "Relevant Images:"로 시작하는 모든 줄 (None, 없음 포함)
                r'(?i)^\s*Rel?le?v?ant Images:.*?(?:None|없음)?[\r\n]*$',
                # 5. "Relevant Images:"로 시작하는 모든 줄 (여러 줄에 걸친 경우)
                r'(?i)Rel?le?v?ant Images:.*?(?=\n\n|$)',
                # 6. "Relevant Images: None" 또는 "Relevant Images: path : (없음)" 형식
                r'(?i)Rel?le?v?ant Images:\s*(?:None|path\s*:\s*\(?없음\)?)[\r\n]*',
                # 7. "Relevant Images: "로 시작하는 모든 텍스트 (None/없음 여부와 상관없이)
                r'(?i)Rel?le?v?ant Images:.*?$',
                # 8. "Relevant Images: "로 시작하는 모든 텍스트 (여러 줄 포함)
                r'(?i)Rel?le?v?ant Images:[\s\S]*?(?=\n\n|$)',
                # 9. "path : (없음)" 형식
                r'path\s*:\s*\(?없음\)?[\r\n]*',
                # 10. "Relevant Images: path : (없음)" 전체 라인
                r'Rel?le?v?ant Images:.*?path\s*:\s*\(?없음\).*?[\r\n]+',
                # 11. "Relevant Images: path : /home/..." 형식 (절대 경로)
                r'(?i)Rel?le?v?ant Images:.*?path\s*:\s*/home/.*?[\r\n]+',
                # 12. "path : /home/..." 형식 (절대 경로만)
                r'path\s*:\s*/home/[^\r\n]*[\r\n]*',
                # 13. "Relevant Images: /home/..." 형식 (직접 경로 지정)
                r'(?i)Rel?le?v?ant Images:\s*/home/[^\r\n]*[\r\n]*',
                # 14. "Relevant Images: None" 형식 (이미지 없음 표시)
                r'(?i)Rel?le?v?ant Images:\s*None[\r\n]*',
                # 15. "Relevant Images: None (There are no images...)" 형식
                r'(?i)Rel?le?v?ant Images:\s*None\s*\([^)]*\)[\r\n]*'
            ]
            
            for pattern in patterns:
                response['answer'] = re.sub(pattern, '', response['answer'], flags=re.DOTALL | re.IGNORECASE | re.MULTILINE)
            
            # 연속된 빈 줄 정리
            response['answer'] = re.sub(r'\n\s*\n', '\n\n', response['answer']).strip()
        
        return response
        
    except Exception as e:
        return {
            'success': False,
            'error': str(e),
            'query': query,
            'results': [],
            'images': []
        }

# Simple chatbot logic for fallback
def generate_simple_response(message: str) -> str:
    # 기본 응답 사전
    responses = {
        "안녕": "안녕하세요! 무엇을 도와드릴까요?",
        "hi": "반갑습니다! 어떤 도움이 필요하신가요?",
        "help": "저는 RAG 기반 AI 어시스턴트입니다. 궁금한 점을 물어보세요!",
        "도움": "무엇을 도와드릴까요? 편하게 말씀해 주세요.",
        "rag": "RAG(Retrieval-Augmented Generation)는 정보 검색과 생성형 AI를 결합한 기술입니다.",
        "기능": "텍스트 검색, 이미지 검색, 질의응답 등 다양한 기능을 제공합니다."
    }
    
    # 소문자로 변환하고 공백 제거
    lower_message = message.lower().strip()
    
    # 키워드 매칭
    for key, response in responses.items():
        if key in lower_message:
            return response
    
    # 기본 응답 - RAG 시스템을 사용하도록 유도
    return "RAG 시스템을 사용하여 답변을 생성 중입니다. 잠시만 기다려 주세요..."

@app.post("/api/chat")
async def chat(request: RAGSearchRequest):
    try:
        if search_integration is None:
            raise HTTPException(status_code=503, detail="RAG 시스템이 초기화되지 않았습니다.")
            
        print(f"[CHAT] 새로운 채팅 요청 수신: {request.query}")
        
        # RAG 시스템을 통해 응답 생성
        response = await search_integration.process_query(
            query=request.query,
            top_k=request.top_k,
            media_type=request.media_type,
            generate_answer=request.generated_answer
        )
        
        print(f"[CHAT] RAG 응답 수신: {json.dumps(response, ensure_ascii=False, indent=2)[:500]}...")
        
        # 결과 포맷팅
        formatted_response = RAGSearchResponse(
            success=True,
            query=request.query,
            results=[],
            answer=response.get('answer', ''),
            images=response.get('images', []),
            generated_answer=request.generated_answer
        )
        
        # 검색 결과 포맷팅
        for doc in response.get('results', []):
            formatted_response.results.append(RAGSearchResultItem(
                score=doc.get('score', 0.0),
                content=doc.get('content', ''),
                metadata=doc.get('metadata', {}),
                media_type=doc.get('media_type', 'text')
            ))
        
        return formatted_response.dict()
        
    except HTTPException:
        raise
    except Exception as e:
        error_msg = f"채팅 처리 중 오류 발생: {str(e)}"
        print(f"[ERROR] {error_msg}")
        raise HTTPException(status_code=500, detail={"error": error_msg})

