    }

# 기존 /chat 엔드포인트 유지 (legacy support)
@app.post("/chat")
async def legacy_chat_endpoint(request: dict):
    """Legacy chat endpoint for backward compatibility"""
    try:
        if search_integration is None:
            return {
                "success": False,
                "error": "RAG 시스템이 초기화되지 않았습니다.",
                "answer": "죄송합니다. 시스템을 초기화하는 중 오류가 발생했습니다.",
                "results": [],
                "images": []
            }
            
        # 요청 형식 변환 (legacy -> new format)
        query = request.get("message", "")
        top_k = request.get("top_k", 5)
        generate_answer = request.get("generated_answer", True)
        
        print(f"[LEGACY_CHAT] 요청 수신: {query}")
        
        # RAG 시스템을 통해 응답 생성 (동기 메서드)
        response = search_integration.process_query(
            query=query,
            top_k=top_k,
            generate_answer=generate_answer
        )
        
        # 이미지 처리 - image_incoder 모듈 사용
        processed_images = []
        
        # 응답 구조 디버깅 로그
        print(f"[DEBUG] Response keys: {list(response.keys())}")
        
        # 이미지 경로 추출 및 처리
        if 'images' in response and response['images']:
            print(f"[DEBUG] Found {len(response['images'])} images in response")
            
            # rag_system 모듈 경로 추가
            rag_system_path = str(Path(__file__).parent.parent.parent.parent / "zone" / "rag_system")
            if rag_system_path not in sys.path:
                sys.path.insert(0, rag_system_path)
                print(f"[DEBUG] Added rag_system to path: {rag_system_path}")
            
            # image_incoder 모듈 임포트
            try:
                from image_incoder import process_response_with_images
                
                # 이미지 정보를 텍스트로 변환 (image_incoder가 처리할 수 있는 형식)
                images_info = []
                for img in response['images']:
                    img_path = img.get('url') or img.get('path') or img.get('image_path')
                    if img_path:
                        # 상대 경로인 경우 절대 경로로 변환
                        if not os.path.isabs(img_path):
                            rag_image_dir = "/home/nextits2/completed_images_2"
                            img_path = os.path.join(rag_image_dir, os.path.basename(img_path))
                        images_info.append({
                            'path': img_path,
                            'caption': img.get('caption', '이미지')
                        })
                
                # 이미지 처리
                if images_info:
                    # process_response_with_images 함수 호출
                    image_paths = "\n".join([f"Image: {img['path']}" for img in images_info])
                    try:
                        processed = process_response_with_images(image_paths, remove_image_section=False)
                        
                        # 처리된 이미지 정보를 응답에 추가
                        if 'images' in processed and processed['images']:
                            processed_images = processed['images']
                            print(f"[DEBUG] Processed {len(processed_images)} images")
                        else:
                            print("[DEBUG] No images processed")
                            processed_images = []
                    except Exception as e:
                        print(f"[ERROR] Failed to process images with image_incoder: {str(e)}")
                        import traceback
                        traceback.print_exc()
                        processed_images = []
                else:
                    print("[DEBUG] No images to process")
                    processed_images = []
            except Exception as e:
                print(f"[ERROR] Failed to import or use image_incoder: {str(e)}")
                import traceback
                traceback.print_exc()
                processed_images = []
        else:
            print("[DEBUG] No images found in response")
            processed_images = []
            
        # 응답 형식 변환 (new -> legacy format)
        answer = response.get("generated_answer", "")
        if processed_images:
            image_paths = "\n".join([img['url'] for img in processed_images if 'url' in img])
            answer = f"{answer}\n\n[이미지]\n{image_paths}"
        
        # 결과가 없을 경우 기본 응답 생성
        if not answer and response.get("results"):
            answer = "검색 결과를 기반으로 한 요약 정보를 제공할 수 없습니다. 자세한 내용은 아래 결과를 참조해주세요."
        
        return {
            "success": True,
            "answer": answer,
            "results": response.get("results", []),
            "images": processed_images,  # base64로 처리된 이미지 데이터 포함
            "generated_answer": generate_answer
        }
        
    except Exception as e:
        error_msg = str(e)
        print(f"[LEGACY_CHAT] Error: {error_msg}")
        return {
            "success": False,
            "error": error_msg,
            "answer": "죄송합니다. 처리 중 오류가 발생했습니다.",
            "results": [],
            "images": []
        }

# 전역 변수 초기화
search_engine = None
search_integration = None
generator = None
rag_config = None

# 애플리케이션 시작 시 RAG 시스템 초기화
@app.on_event("startup")
async def startup_event():
    """서버 시작 시 RAG 시스템 초기화"""
    global search_engine, search_integration, generator, rag_config
    
    try:
        if search_engine is None:
            print("RAG 시스템 컴포넌트를 초기화하는 중...")
            # 개발 버전의 rag_search.py를 사용하기 위해 경로 추가
            import sys
            sys.path.insert(0, '/home/nextits2/.conda/envs/workbox/zone/rag_system_dev copy/')
            from rag_config import RAGConfig
            from rag_search import RAGSearchEngine
            from rag_integration import SearchIntegration
            
            # Initialize configuration
            rag_config = RAGConfig()
            print("RAG 설정이 로드되었습니다.")
            
            # Initialize search engine
            search_engine = RAGSearchEngine(rag_config)
            print("검색 엔진이 초기화되었습니다.")
            
            # Initialize generator
            try:
                from ollamagen import OllamaGenerator
                generator = OllamaGenerator()
                print("Ollama 생성기가 초기화되었습니다.")
            except ImportError as e:
                print(f"경고: Ollama 생성기 초기화 실패 - {e}")
                generator = None
            
            # Initialize search integration
            if search_engine and generator:
                search_integration = SearchIntegration(search_engine, generator)
                print("검색 통합이 초기화되었습니다.")
            
            print("RAG 시스템 초기화가 완료되었습니다.")
            
    except Exception as e:
        import traceback
        error_msg = f"RAG 시스템 초기화 실패: {str(e)}\n{traceback.format_exc()}"
        print(error_msg)
        search_engine = None
        search_integration = None
        generator = None
        rag_config = None

# 서버 실행 설정
if __name__ == "__main__":
    import argparse
    
    # 명령줄 인수 파서 설정
    parser = argparse.ArgumentParser(description='RAG 기반 챗봇 API 서버')
    parser.add_argument('--reload', action='store_true', help='자동 리로드 활성화')
    args = parser.parse_args()
    
    # 프론트엔드의 환경변수에서 서버 설정 가져오기
    HOST = os.getenv('REACT_APP_LOCALHOST')
    PORT = int(os.getenv('REACT_APP_LOCALHOST_BACK_PORT'))
    
    print(f"서버 시작: http://{HOST}:{PORT}")
    print(f"API 문서: http://{HOST}:{PORT}/docs")
    
    # 서버 실행
    uvicorn.run(
        "main:app",
        host=HOST,
        port=PORT,
        reload=args.reload
    )
