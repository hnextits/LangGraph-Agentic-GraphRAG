# 환경 설정 (test/production)
ENVIRONMENT=production

# 운영 환경 Weaviate 설정
WEAVIATE_HOST=127.0.0.1
WEAVIATE_PORT=8080

# 테스트 환경 Weaviate 설정 (필요시 사용)
# TEST_WEAVIATE_HOST=localhost
# TEST_WEAVIATE_PORT=8080

# Neo4j 설정
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=
NEO4J_PASSWORD=

# 이미지 검색 기본 경로 (쉼표로 구분)
IMAGE_BASE_PATHS=./nextits_data/Results/5.Completion_results/image,./nextits_data/Results,./nextits_data,./backend,./frontend/public/images,./images

# 검색 필터링 사이트 (쉼표로 구분)
SEARCH_FILTER_SITES=namu.wiki,wikipedia.org,news.nate.com
