#!/usr/bin/env python
# -*- coding: utf-8 -*-

"""
RAG 시스템 정제기 - 최종 답변을 사용자에게 적합하게 다듬습니다.
"""

import os
import json
import logging
import torch
from typing import List, Dict, Any, Optional
from transformers import AutoModelForCausalLM, AutoTokenizer

# config.py 임포트
from config import RAGConfig

# 로깅 설정 - 실행, 종료, 오류만 로깅
logger = logging.getLogger(__name__)

class Refiner:
    """
    RAG 시스템 정제기
    Generator의 모델을 공유하여 최종 답변을 다듬습니다.
    """
    
    def __init__(self, generator, config: RAGConfig = None):
        """
        정제기 초기화
        
        Args:
            generator: 이미 초기화된 Generator 인스턴스
            config: RAGConfig 인스턴스
        """
        if config is None:
            config = RAGConfig()
        
        self.config = config
        self.generator = generator  # Generator 인스턴스 저장
        self.model = generator.model
        self.tokenizer = generator.tokenizer
        self.device = generator.device
        
        if self.model is None or self.tokenizer is None:
            raise ValueError("Refiner는 초기화된 모델과 토크나이저를 포함한 Generator 인스턴스가 필요합니다.")

        logger.info(f"Refiner 초기화 완료. Generator의 모델({self.generator.model_name})을 공유합니다.")
    

    
    def refine_answer(self, query: str, answer: str) -> str:
        """
        답변 정제
        
        Args:
            query: 사용자 질문
            answer: 원본 답변
            
        Returns:
            정제된 답변
        """
        logger.info(f"refiner.refine_answer 호출됨 - 원본 답변 길이: {len(answer)}")
        
        # 원본 답변에서 <think> 태그와 내용 제거
        if "<think>" in answer and "</think>" in answer:
            try:
                answer_parts = answer.split("<think>", 1)
                think_and_rest = answer_parts[1].split("</think>", 1)
                answer = answer_parts[0].strip() + " " + think_and_rest[1].strip()
                logger.info(f"<think> 태그 제거 후 원본 답변 길이: {len(answer)}")
            except IndexError:
                logger.warning("원본 답변의 <think> 태그 처리 중 오류 발생")
        elif "<think>" in answer:
            try:
                parts = answer.split("<think>", 1)
                if "\n\n" in parts[1]:
                    answer = parts[0].strip() + " " + parts[1].split("\n\n", 1)[1].strip()
                    logger.info(f"<think> 태그 제거 후 원본 답변 길이: {len(answer)}")
            except IndexError:
                logger.warning("원본 답변의 <think> 태그 처리 중 오류 발생")
        
        # 프롬프트 구성 - REFINER 역할과 마크다운 출력 형식, 중복 제거에 특화
        system_prompt = self.config.REFINER_SYSTEM_PROMPT
        user_prompt = self.config.REFINER_USER_PROMPT_TEMPLATE.format(query=query, answer=answer)
        
        # LLM을 통한 정제 수행
        try:
            refined_answer = self._generate_with_shared_model(system_prompt, user_prompt)
            
            # 중복 문장 제거
            refined_answer = self._remove_duplicated_sentences(refined_answer)
            
            # 헤더 제거 - 정제된 답변을 그대로 사용
            # refined_answer = "정제된 답변:\n" + refined_answer
                
            # <think> 태그와 내용 제거
            if "<think>" in refined_answer and "</think>" in refined_answer:
                try:
                    refined_answer = refined_answer.split("</think>", 1)[1].strip()
                except IndexError:
                    logger.warning("</think> 태그 이후 내용이 없습니다")
            elif "<think>" in refined_answer:
                try:
                    refined_answer = refined_answer.split("<think>", 1)[1].strip()
                    # 첫 번째 빈 줄(\n\n)까지의 내용을 <think> 내용으로 간주하고 제거
                    if "\n\n" in refined_answer:
                        refined_answer = refined_answer.split("\n\n", 1)[1].strip()
                except IndexError:
                    logger.warning("<think> 태그 처리 중 오류 발생")
            
            logger.info(f"답변 정제 완료 - 정제된 답변 길이: {len(refined_answer)}")
            logger.info(f"정제 전 답변 일부: {answer[:50]}...")
            logger.info(f"정제 후 답변 일부: {refined_answer[:50]}...")
            
            # 정제된 답변이 비어있으면 원본 답변 반환
            if not refined_answer.strip():
                logger.warning("정제된 답변이 비어있어서 원본 답변을 반환합니다.")
                return answer
                
            return refined_answer
        except Exception as e:
            logger.error(f"답변 정제 실패: {str(e)}")
            return answer  # 실패 시 원본 답변 반환
    
    def _remove_duplicated_sentences(self, text: str) -> str:
        """
        중복된 문장 제거
        
        Args:
            text: 원본 텍스트
            
        Returns:
            중복 문장이 제거된 텍스트
        """
        if not text:
            return text
            
        # 문장들을 분리
        sentences = []
        current_sentence = ""
        
        # 문장 분리
        for line in text.split('\n'):
            if not line.strip():
                if current_sentence:
                    sentences.append(current_sentence.strip())
                    current_sentence = ""
                sentences.append("")
            else:
                if line.strip().endswith(('.', '!', '?', ':', ';')):
                    current_sentence += line
                    sentences.append(current_sentence.strip())
                    current_sentence = ""
                else:
                    current_sentence += line + " "
        
        if current_sentence:
            sentences.append(current_sentence.strip())
        
        # 중복 문장 제거
        seen_sentences = set()
        unique_sentences = []
        
        for sentence in sentences:
            # 빈 줄은 그대로 유지
            if not sentence:
                unique_sentences.append(sentence)
                continue
                
            # 중복 문장 제거
            if sentence.lower() not in seen_sentences:
                seen_sentences.add(sentence.lower())
                unique_sentences.append(sentence)
        
        # 문장들을 다시 합치기
        return '\n'.join(unique_sentences)
    
    def _generate_with_shared_model(self, system_prompt: str, user_prompt: str) -> str:
        """
        공유된 Generator 모델을 사용하여 텍스트를 생성합니다.
        
        Args:
            system_prompt: 시스템 프롬프트
            user_prompt: 사용자 프롬프트
            
        Returns:
            생성된 텍스트
        """
        try:
            prompt = f"<|im_start|>system\n{system_prompt}<|im_end|>\n<|im_start|>user\n{user_prompt}<|im_end|>\n<|im_start|>assistant\n"
            
            logger.info(f"공유 모델({self.generator.model_name})로 텍스트 생성 중")
            
            inputs = self.tokenizer(prompt, return_tensors="pt").to(self.device)
            
            generation_params = {
                "max_new_tokens": self.config.REFINER_MAX_TOKENS,
                "num_beams": self.config.REFINER_NUM_BEAMS,
                "do_sample": self.config.REFINER_DO_SAMPLE,
                "pad_token_id": self.tokenizer.eos_token_id
            }

            if self.config.REFINER_DO_SAMPLE:
                generation_params.update({
                    "temperature": self.config.REFINER_TEMPERATURE,
                    "top_p": self.config.REFINER_TOP_P,
                })

            outputs = self.model.generate(**inputs, **generation_params)
            
            input_length = inputs['input_ids'].shape[1]
            new_tokens = outputs[0][input_length:]
            response = self.tokenizer.decode(new_tokens, skip_special_tokens=True).strip()
            
            if not response:
                logger.warning("Refiner가 빈 응답을 생성했습니다.")
                return ""
            
            return response
        except Exception as e:
            logger.error(f"공유 모델 텍스트 생성 실패: {str(e)}", exc_info=True)
            raise
    
    def refine(self, original_answer: str, context: str = "", query: str = "") -> str:
        """
        답변을 정제하여 개선
        
        Args:
            original_answer: 원본 답변
            context: 추가 컨텍스트 (선택적)
            query: 원본 질문 (선택적)
            
        Returns:
            정제된 답변
        """
        try:
            # 시스템 프롬프트 구성
            system_prompt = self.config.REFINER_SYSTEM_PROMPT

            # 사용자 프롬프트 구성
            user_prompt = self.config.REFINER_USER_PROMPT.format(
                answer=original_answer,
                context=context,
                query=query
            )

            logger.info("답변 정제 시작")
            
            # 답변 정제 실행
            refined_answer = self._generate_with_shared_model(system_prompt, user_prompt)
            
            logger.info("답변 정제 완료")
            return refined_answer
            
        except Exception as e:
            logger.error(f"답변 정제 실패: {str(e)}")
            # 오류 시 원본 답변 반환
            return original_answer